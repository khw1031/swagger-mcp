{
  "name": "@hynu/swagger-mcp",
  "version": "1.0.7",
  "description": "An open-source MCP server that provides API documentation (Swagger/OpenAPI) to LLMs through the Model Context Protocol",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./src/index.ts",
  "bin": {
    "hynu-swagger-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "prepublishOnly": "pnpm run build",
    "publish:public": "pnpm publish --access public --no-git-checks"
  },
  "keywords": [
    "mcp",
    "swagger",
    "openapi",
    "api",
    "api-documentation",
    "api-documentation-mcp",
    "model-context-protocol",
    "llm",
    "ai"
  ],
  "author": {
    "name": "Hyunwoo Kim",
    "email": "khw1031@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khw1031/swagger-mcp.git"
  },
  "homepage": "https://github.com/khw1031/swagger-mcp#readme",
  "bugs": {
    "url": "https://github.com/khw1031/swagger-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.7.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@scalar/openapi-parser": "^0.23.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@scalar/openapi-types": "^0.5.3",
    "@smithery/cli": "^1.4.6",
    "@types/node": "^25.0.3",
    "tsdown": "^0.18.0",
    "typescript": "^5.9.3"
  }
}
